diff --git a/node_modules/expo-modules-autolinking/scripts/android/autolinking_implementation.gradle b/node_modules/expo-modules-autolinking/scripts/android/autolinking_implementation.gradle
index 98c404e..b67c5c9 100644
--- a/node_modules/expo-modules-autolinking/scripts/android/autolinking_implementation.gradle
+++ b/node_modules/expo-modules-autolinking/scripts/android/autolinking_implementation.gradle
@@ -329,6 +329,26 @@ if (rootProject instanceof ProjectDescriptor) {
       }
       for (module in modules) {
         for (modulePlugin in module.plugins) {
+          // Guard: only apply a module's gradle plugin to the root/app project when the
+          // module explicitly opts in via `applyToRootProject: true` in its
+          // expo-module.config.json. `expo-modules-core` ships expo-module-gradle-plugin
+          // with applyToRootProject:false, so it must NOT be applied to :app (it already
+          // applies com.android.library to itself, which would clash with :app's
+          // com.android.application). This mirrors the behavior of newer
+          // expo-modules-autolinking (2.1.x).
+          // NOTE: expo-modules-autolinking@2.0.8 predates the `applyToRootProject` field,
+          // so its ExpoModuleGradlePlugin objects do NOT expose it (accessing it throws
+          // MissingPropertyException). Read it defensively: missing => treat as false =>
+          // skip, which is correct because no module in this project needs a root plugin.
+          def applyToRootProject = false
+          try {
+            applyToRootProject = modulePlugin.applyToRootProject == true
+          } catch (ignore) {
+            applyToRootProject = false
+          }
+          if (!applyToRootProject) {
+            continue
+          }
           println " ${Emojis.INFORMATION}  ${Colors.YELLOW}Applying gradle plugin${Colors.RESET} '${Colors.GREEN}${modulePlugin.id}${Colors.RESET}' (${module.name}@${module.version})"
           project.plugins.apply(modulePlugin.id)
         }
